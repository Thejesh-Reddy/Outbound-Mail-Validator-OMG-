# Copy this file to .env and fill in your local values.
OMG_ENV=development
OMG_ENVIRONMENT=development
OMG_API_KEY=YOUR_API_KEY_HERE
OMG_MAX_REQUEST_BYTES=65000000
OMG_ENABLE_ML=false
OMG_REQUIRE_ML=false
OMG_MODEL_PATH=Content/models/email_classifier.joblib
OMG_RULES_PATH=Content/data/omg_rules.json
OMG_ML_MIN_CONFIDENCE=0.60
OMG_MAX_FILES=5
OMG_MAX_FILE_MB=25
OMG_MAX_TOTAL_MB=60
OMG_DENIED_HASHES_FILE=Attachments/security/denied_hashes.txt
OMG_REQUIRE_CLAMAV=false
OMG_CLAMAV_HOST=127.0.0.1
OMG_CLAMAV_PORT=3310
OMG_CONTENT_ENABLED=true
OMG_CLAMAV_TIMEOUT=10
OMG_CONTENT_LURE_RULES=true
OMG_CONTENT_OCR_MODE=when_needed
OMG_CONTENT_OCR_REQUIRED=false
OMG_CONTENT_IMAGE_POLICY=ocr_only
OMG_ML_MODE=off
OMG_CONTENT_ML_MODE=off
OMG_WARNING_SIGNING_KEY=
OMG_TRUSTED_LINK_DOMAINS=
OMG_ENABLE_EXPERIMENTAL_TFIDF=false

# MongoDB Atlas connection. Do not commit the real .env file.
MONGODB_URI=
MONGODB_DB=OMG_Database

# LOCAL-ONLY Validation Insights frontend testing (disabled by default).
# Set true and provide a known users._id only in your local .env file.
OMG_INSIGHTS_DEV_TEST_MODE=false
OMG_INSIGHTS_TEST_ACCOUNT_ID=YOUR_TEST_ACCOUNT_ID

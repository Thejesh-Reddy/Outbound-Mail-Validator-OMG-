# OMG local development configuration
OMG_ENVIRONMENT=development
OMG_API_PREFIX=/api/v1
OMG_RULES_PATH=data/omg_rules.json
OMG_MODEL_PATH=models/email_classifier.joblib
OMG_REQUIRE_ML=false
OMG_ML_MIN_CONFIDENCE=0.60
OMG_LOG_LEVEL=INFO
OMG_MAX_REQUEST_BYTES=65000000

# Optional local ClamAV configuration.
# Attachments are blocked when ClamAV is unavailable.
# OMG_CLAMSCAN_PATH=C:\\Program Files\\ClamAV\\clamscan.exe
# OMG_ATTACHMENT_SCAN_TIMEOUT=30

# Production: set OMG_ENVIRONMENT=production, OMG_REQUIRE_ML=true,
# and provide a strong random OMG_API_KEY (at least 32 characters).
# Verify the model and runtime rules files exist before deployment.
# OMG_API_KEY=replace_with_a_secure_random_secret

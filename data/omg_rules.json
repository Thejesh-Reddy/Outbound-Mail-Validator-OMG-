{
  "version": "1.0.0",
  "description": "Runtime-editable heuristic rules for outgoing email inspection. These rules are indicators, not a complete malware or reputation scanner.",
  "rules": [
    {"code":"LOTTERY_SCAM","category":"FRAUD","patterns":["\\bclaim your lottery prize\\b","\\byou have won\\b.{0,80}\\bprize\\b","\\bclaim your winnings\\b","\\blottery winner\\b"]},
    {"code":"CREDENTIAL_PHISHING","category":"PHISHING","patterns":["\\bverify your password\\b","\\bconfirm your login credentials\\b","\\baccount will be suspended\\b","\\breset your password immediately\\b","\\bvalidate your credentials\\b"]},
    {"code":"UNSOLICITED_SPAM","category":"SPAM","patterns":["\\bearn money fast\\b","\\bguaranteed income\\b","\\bact now\\b.{0,60}\\blimited offer\\b","\\bmake money from home\\b.{0,80}\\bguaranteed\\b"]},
    {"code":"ADVANCE_FEE_SCAM","category":"FRAUD","patterns":["\\bpay (?:a )?small (?:processing )?fee\\b.{0,100}\\b(prize|inheritance|funds|reward)\\b","\\btransfer fee\\b.{0,80}\\brelease (?:your )?(?:funds|inheritance)\\b"]},
    {
      "code": "URGENT_PAYMENT_DEMAND",
      "category": "SOCIAL_ENGINEERING",
      "patterns": [
        "\\burgent wire transfer\\b",
        "\\bchange of bank details\\b.{0,100}\\bpay immediately\\b",
        "\\bdo not call me\\b.{0,80}\\bpayment\\b",
        "\\btransfer (?:the )?payment immediately\\b",
        "\\btransfer funds immediately\\b",
        "\\b(?:urgent|immediate) payment required\\b",
        "\\bpay immediately\\b.{0,100}\\b(?:account suspension|account closure)\\b",
        "\\btransfer (?:the )?payment\\b.{0,100}\\bto avoid account suspension\\b"
      ]
    },
    {"code":"MFA_CODE_REQUEST","category":"CREDENTIAL_THEFT","patterns":["\\bsend (?:me )?(?:the )?(?:mfa|2fa|verification|one.time) code\\b","\\bshare your authentication code\\b"]},
    {"code":"FAKE_GIVEAWAY","category":"FRAUD","patterns":["\\byou have been selected\\b.{0,80}\\b(gift card|giveaway|free iphone)\\b","\\bclaim your free (?:gift card|iphone|prize)\\b"]},
    {"code":"HTML_FORM_CREDENTIAL_CAPTURE","category":"HTML_INSPECTION","patterns":["\\benter your password\\b","\\bsubmit your credentials\\b","\\bconfirm your bank login\\b"]}
  ]
}
